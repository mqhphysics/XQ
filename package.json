{
  "name": "xiaoqiu-xq",
  "version": "0.1.0",
  "private": true,
  "description": "晓球校园足球赛事与社区平台",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.5.2"
  },
  "scripts": {
    "dev:api": "pnpm --filter @xiaoqiu/api dev",
    "dev:worker": "pnpm --filter @xiaoqiu/worker dev",
    "dev:weapp": "pnpm --filter @xiaoqiu/weapp dev",
    "dev:web": "pnpm --filter @xiaoqiu/web dev",
    "dev:admin": "pnpm --filter @xiaoqiu/admin-web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "globals": "latest",
    "prettier": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest"
  }
}
