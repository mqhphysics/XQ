generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  FROZEN
  DELETED

  @@map("user_status")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT

  @@map("membership_status")
}

enum Role {
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  TOURNAMENT_ADMIN
  TEAM_CAPTAIN
  TEAM_COACH
  MATCH_REPORTER
  OFFICIAL
  REVIEWER

  @@map("role")
}

enum RoleScopeType {
  PLATFORM
  ORGANIZATION
  TOURNAMENT
  TEAM
  MATCH

  @@map("role_scope_type")
}

enum AuditActorType {
  USER
  MATCH_REPORTER
  OFFICIAL
  ADMIN
  SYSTEM
  WORKER
  IMPORT_BATCH
  EMERGENCY_SQL

  @@map("audit_actor_type")
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED

  @@map("outbox_job_status")
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("tournament_status")
}

enum CompetitionRuleVersionStatus {
  PUBLISHED
  RETIRED

  @@map("competition_rule_version_status")
}

enum StageType {
  GROUP
  KNOCKOUT

  @@map("stage_type")
}

enum SchedulePlanStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("schedule_plan_status")
}

enum ScheduleRevisionStatus {
  PUBLISHED

  @@map("schedule_revision_status")
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED

  @@map("match_status")
}

enum TeamRegistrationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  WITHDRAWN
  SUSPENDED

  @@map("team_registration_status")
}

enum RosterSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  LOCKED
  REOPENED
  WITHDRAWN

  @@map("roster_submission_status")
}

enum DataQualityStatus {
  CLEAN
  WARNING
  ERROR

  @@map("data_quality_status")
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("import_batch_status")
}

enum VerificationLevel {
  UNVERIFIED
  STUDENT_VERIFIED
  PLAYER_CONFIRMED
  STAFF_VERIFIED

  @@map("verification_level")
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD

  @@map("player_position")
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH

  @@map("dominant_foot")
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION

  @@map("match_event_type")
}

enum PostType {
  OFFICIAL
  COMMUNITY

  @@map("post_type")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN

  @@map("post_status")
}

enum PostTagKind {
  TOPIC
  TEAM
  PLAYER

  @@map("post_tag_kind")
}

enum TeamMembershipStatus {
  ACTIVE
  REMOVED

  @@map("team_membership_status")
}

enum TeamJoinApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("team_join_application_status")
}

enum NotificationType {
  SYSTEM_MESSAGE
  STUDENT_REGISTRATION
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED
  TEAM_APPLICATION
  TEAM_APPLICATION_DECIDED
  REPORT_CREATED
  REPORT_UPDATED
  DIRECT_MESSAGE
  ROSTER_SUBMITTED
  ROSTER_UPDATED
  MATCH_REPORT_SUBMITTED
  MATCH_REPORT_REVIEWED

  @@map("notification_type")
}

enum ReportTargetType {
  POST
  COMMENT
  MATCH_REVIEW
  DIRECT_MESSAGE
  USER
  FEEDBACK

  @@map("report_target_type")
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED

  @@map("report_status")
}

model Organization {
  messagePreferences UserMessagePreference[]
  userBlocks UserBlock[]
  technicalLogs MatchTechnicalLog[]
  aiModerationSetting AiModerationSetting?
  aiModerationProviders AiModerationProvider[]
  aiModerationReviews AiModerationReview[]
  registrationHelpRequests RegistrationHelpRequest[]
  students             StudentRecord[]
  competitions         CompetitionDefinition[]
  identityRecords      IdentityRecord[]
  identityApplications IdentityApplication[]
  managedMediaAssets   ManagedMediaAsset[]
  id                   String                   @id @default(uuid()) @db.Uuid
  slug                 String                   @unique(map: "organizations_slug_key") @db.VarChar(64)
  name                 String                   @db.VarChar(120)
  status               OrganizationStatus       @default(ACTIVE)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships          OrganizationMembership[]
  userSessions         UserSession[]
  roleAssignments      RoleAssignment[]
  auditLogs            AuditLog[]
  idempotencyRecords   IdempotencyRecord[]
  outboxJobs           OutboxJob[]
  seasons              Season[]
  tournaments          Tournament[]
  teams                Team[]
  playerProfiles       PlayerProfile[]
  venues               Venue[]
  schedulePlans        SchedulePlan[]
  scheduleRevisions    ScheduleRevision[]
  matches              Match[]
  teamRegistrations    TeamRegistration[]
  rosterSubmissions    RosterSubmission[]
  rosterEntries        RosterEntry[]
  rosterSnapshots      RosterSnapshot[]
  snapshotEntries      RosterSnapshotEntry[]
  importBatches        ImportBatch[]
  teamPreferences      UserTeamPreference[]
  badgePreferences     UserBadgePreference[]
  hubStripOrders       UserHubStripOrder[]
  matchEvents          MatchEvent[]
  matchAppearances     MatchAppearance[]
  matchReviews         MatchReview[]
  matchCheckins        MatchCheckin[]
  matchInterests       UserMatchInterest[]
  posts                Post[]
  postLikes            PostLike[]
  postFavorites        PostFavorite[]
  postCommentLikes     PostCommentLike[]
  postComments         PostComment[]
  postTags             PostTag[]
  playerFollows        UserPlayerFollow[]
  teamMemberships      TeamMembership[]
  teamApplications     TeamJoinApplication[]
  notifications        UserNotification[]
  reports              ContentReport[]
  directConversations  DirectConversation[]
  directMessages       DirectMessage[]

  matchReportRevisions   MatchReportRevision[]
  lineupPlans            TeamLineupPlan[]
  lineupRevisions        TeamLineupRevision[]
  resultProjections      MatchResultProjection[]
  tournamentProgressions TournamentProgression[]

  emailAuthCodes EmailAuthCode[]
  emailChanges   EmailChangeRequest[]

  @@map("organizations")
  feedEvents PostFeedEvent[]

}

model User {
  loginAliases UserLoginAlias[]
  messagePreferences UserMessagePreference[]
  blockedUsers UserBlock[] @relation("UserBlocker")
  blockedByUsers UserBlock[] @relation("UserBlocked")
  technicalLogs MatchTechnicalLog[]
  showPlayerIdentity Boolean @default(true) @map("show_player_identity")
  profileCohort                String                   @default("LEGACY") @map("profile_cohort") @db.VarChar(64)
  studentRecordId              String?                  @unique @map("student_record_id") @db.Uuid
  studentRecord                StudentRecord?           @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  studentVerifiedAt            DateTime?                @map("student_verified_at") @db.Timestamptz(3)
  onboardingCompletedAt        DateTime?                @map("onboarding_completed_at") @db.Timestamptz(3)
  playerOfferDismissedAt       DateTime?                @map("player_offer_dismissed_at") @db.Timestamptz(3)
  coverUrl                     String?                  @default("/api/media/defaults/user-cover-v1.webp") @map("cover_url") @db.VarChar(512)
  reporterProfiles             ReporterProfile[]
  createdIdentityRecords       IdentityRecord[]         @relation("IdentityRecordCreator")
  linkedIdentityRecords        IdentityRecord[]         @relation("IdentityRecordUser")
  identityApplications         IdentityApplication[]    @relation("IdentityApplicant")
  reviewedIdentityApplications IdentityApplication[]    @relation("IdentityReviewer")
  uploadedMediaAssets          ManagedMediaAsset[]      @relation("ManagedMediaUploader")
  reviewedMediaAssets          ManagedMediaAsset[]      @relation("ManagedMediaReviewer")
  mediaChanges                 ManagedMediaAsset[]      @relation("ManagedMediaVisibilityActor")
  id                           String                   @id @default(uuid()) @db.Uuid
  loginNameNormalized          String?                  @map("login_name_normalized") @db.VarChar(120)
  displayName                  String                   @map("display_name") @db.VarChar(120)
  realName                     String?                  @map("real_name") @db.VarChar(120)
  realNameNormalized           String?                  @map("real_name_normalized") @db.VarChar(120)
  studentId                    String?                  @unique(map: "app_users_student_id_key") @map("student_id") @db.VarChar(32)
  email                        String?                  @db.VarChar(254)
  emailNormalized              String?                  @unique(map: "app_users_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  emailVerifiedAt              DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  avatarUrl                    String?                  @default(dbgenerated("xiaoqiu_default_avatar('user'::text)")) @map("avatar_url") @db.VarChar(512)
  bio                          String?                  @db.VarChar(280)
  verificationLevel            VerificationLevel        @default(UNVERIFIED) @map("verification_level")
  playerProfileId              String?                  @unique(map: "app_users_player_profile_id_key") @map("player_profile_id") @db.Uuid
  status                       UserStatus               @default(ACTIVE)
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                  OrganizationMembership[]
  wechatIdentities             WechatIdentity[]
  sessions                     UserSession[]
  roleAssignments              RoleAssignment[]         @relation("RoleAssignmentUser")
  grantedAssignments           RoleAssignment[]         @relation("RoleAssignmentGrantor")
  auditLogs                    AuditLog[]
  idempotencyRecords           IdempotencyRecord[]
  passwordCredential           PasswordCredential?
  playerProfile                PlayerProfile?           @relation("UserLinkedPlayer", fields: [playerProfileId], references: [id], onDelete: SetNull)
  teamPreferences              UserTeamPreference[]
  badgePreferences             UserBadgePreference[]
  hubStripOrders               UserHubStripOrder[]
  posts                        Post[]                   @relation("PostAuthor")
  postLikes                    PostLike[]
  postFavorites                PostFavorite[]
  postCommentLikes             PostCommentLike[]
  postComments                 PostComment[]
  matchReviews                 MatchReview[]
  matchCheckins                MatchCheckin[]
  matchInterests               UserMatchInterest[]
  playerFollows                UserPlayerFollow[]
  teamMemberships              TeamMembership[]
  teamApplications             TeamJoinApplication[]    @relation("TeamApplicationApplicant")
  reviewedApplications         TeamJoinApplication[]    @relation("TeamApplicationReviewer")
  notifications                UserNotification[]       @relation("NotificationRecipient")
  notificationActions          UserNotification[]       @relation("NotificationActor")
  reports                      ContentReport[]          @relation("ReportReporter")
  handledReports               ContentReport[]          @relation("ReportHandler")
  conversationsAsOne           DirectConversation[]     @relation("ConversationUserOne")
  conversationsAsTwo           DirectConversation[]     @relation("ConversationUserTwo")
  directMessages               DirectMessage[]          @relation("DirectMessageSender")

  matchReportRevisions   MatchReportRevision[]   @relation("MatchReportAuthor")
  lineupRevisions        TeamLineupRevision[]    @relation("LineupRevisionAuthor")
  lineupConfirmations    TeamLineupPlan[]        @relation("LineupConfirmationAuthor")
  tournamentProgressions TournamentProgression[] @relation("ProgressionAuthor")
  emailAuthCodes         EmailAuthCode[]
  emailChanges           EmailChangeRequest[]

  @@index([realNameNormalized], map: "app_users_real_name_normalized_idx")
  @@map("app_users")
  feedEvents PostFeedEvent[]

}

model UserLoginAlias {
  aliasNormalized String @id @map("alias_normalized") @db.VarChar(120)
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("user_login_aliases")
}

model UserMessagePreference {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  likes String @default("ALL") @db.VarChar(16)
  replies String @default("ALL") @db.VarChar(16)
  directMessages Boolean @default(true) @map("direct_messages")
  systemMessages Boolean @default(true) @map("system_messages")
  badges Boolean @default(true)
  version Int @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "user_message_preferences_org_user_key")
  @@map("user_message_preferences")
}

model UserBlock {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  blockerUserId String @map("blocker_user_id") @db.Uuid
  blockedUserId String @map("blocked_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blocker User @relation("UserBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, blockerUserId, blockedUserId], map: "user_blocks_org_blocker_blocked_key")
  @@index([organizationId, blockedUserId, blockerUserId], map: "user_blocks_org_blocked_blocker_idx")
  @@map("user_blocks")
}

model EmailAuthCode {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  emailNormalized String              @map("email_normalized") @db.VarChar(254)
  purpose         String              @db.VarChar(32)
  contextId       String?             @map("context_id") @db.Uuid
  context         EmailChangeRequest? @relation(fields: [contextId], references: [id], onDelete: Cascade)
  userId          String?             @map("user_id") @db.Uuid
  codeDigest      String              @map("code_digest") @db.VarChar(64)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz(3)
  attempts        Int                 @default(0)
  sendStatus      String              @default("PENDING") @map("send_status") @db.VarChar(16)
  consumedAt      DateTime?           @map("consumed_at") @db.Timestamptz(3)
  ipAddress       String?             @map("ip_address") @db.Inet
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, emailNormalized, purpose, createdAt], map: "email_auth_codes_lookup_idx")
  @@index([emailNormalized, createdAt], map: "email_auth_codes_email_rate_idx")
  @@index([ipAddress, createdAt], map: "email_auth_codes_ip_rate_idx")
  @@index([createdAt], map: "email_auth_codes_created_idx")
  @@map("email_auth_codes")
}

model EmailChangeRequest {
  codes                   EmailAuthCode[]
  id                      String          @id @default(uuid()) @db.Uuid
  organizationId          String          @map("organization_id") @db.Uuid
  userId                  String          @map("user_id") @db.Uuid
  sessionId               String          @map("session_id") @db.Uuid
  previousEmailNormalized String?         @map("previous_email_normalized") @db.VarChar(254)
  newEmailNormalized      String?         @map("new_email_normalized") @db.VarChar(254)
  oldVerifiedAt           DateTime?       @map("old_verified_at") @db.Timestamptz(3)
  expiresAt               DateTime        @map("expires_at") @db.Timestamptz(3)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(3)
  version                 Int             @default(1)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  organization            Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  session                 UserSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, expiresAt], map: "email_change_requests_session_idx")
  @@map("email_change_requests")
}

model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique(map: "password_credentials_user_id_key") @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(256)
  passwordSalt String   @map("password_salt") @db.VarChar(128)
  algorithm    String   @default("scrypt-v1") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(PENDING)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@index([organizationId, status], map: "organization_memberships_organization_id_status_idx")
  @@index([userId, status], map: "organization_memberships_user_id_status_idx")
  @@map("organization_memberships")
}

model WechatIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String   @default("WECHAT") @db.VarChar(32)
  openid    String   @db.VarChar(128)
  unionid   String?  @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, openid], map: "wechat_identities_provider_openid_key")
  @@index([userId], map: "wechat_identities_user_id_idx")
  @@map("wechat_identities")
}

model UserSession {
  emailChanges     EmailChangeRequest[]
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  refreshTokenHash String               @unique(map: "user_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt       DateTime?            @map("last_seen_at") @db.Timestamptz(3)
  ipAddress        String?              @map("ip_address") @db.Inet
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt], map: "user_sessions_user_id_revoked_at_expires_at_idx")
  @@index([organizationId, revokedAt, expiresAt], map: "user_sessions_organization_id_revoked_at_expires_at_idx")
  @@map("user_sessions")
}

model RoleAssignment {
  identityRecords IdentityRecord[]

  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            Role
  scopeType       RoleScopeType @map("scope_type")
  scopeId         String        @map("scope_id") @db.VarChar(64)
  grantedByUserId String?       @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User          @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser   User?         @relation("RoleAssignmentGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, role, scopeType, scopeId], map: "role_assignments_user_id_role_scope_type_scope_id_key")
  @@index([organizationId, revokedAt], map: "role_assignments_organization_id_revoked_at_idx")
  @@index([userId, revokedAt], map: "role_assignments_user_id_revoked_at_idx")
  @@map("role_assignments")
}

model AuditLog {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  actorType         AuditActorType @map("actor_type")
  actorUserId       String?        @map("actor_user_id") @db.Uuid
  actorRoleSnapshot Json?          @map("actor_role_snapshot") @db.JsonB
  action            String         @db.VarChar(120)
  targetType        String         @map("target_type") @db.VarChar(120)
  targetId          String         @map("target_id") @db.VarChar(128)
  beforeSummary     Json?          @map("before_summary") @db.JsonB
  afterSummary      Json?          @map("after_summary") @db.JsonB
  reason            String?        @db.VarChar(500)
  requestId         String         @map("request_id") @db.VarChar(128)
  correlationId     String?        @map("correlation_id") @db.VarChar(128)
  ipAddress         String?        @map("ip_address") @db.Inet
  userAgent         String?        @map("user_agent") @db.VarChar(512)
  source            String         @db.VarChar(64)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType, targetId, createdAt], map: "audit_logs_organization_id_target_type_target_id_created_at_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  route          String        @db.VarChar(200)
  idempotencyKey String        @map("idempotency_key") @db.VarChar(128)
  requestHash    String        @map("request_hash") @db.Char(64)
  responseStatus Int?          @map("response_status")
  responseBody   Json?         @map("response_body") @db.JsonB
  resourceType   String?       @map("resource_type") @db.VarChar(120)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, idempotencyKey], map: "idempotency_records_user_id_route_idempotency_key_key")
  @@index([organizationId, createdAt], map: "idempotency_records_organization_id_created_at_idx")
