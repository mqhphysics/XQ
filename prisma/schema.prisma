  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament      Tournament             @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ruleVersion     CompetitionRuleVersion @relation(fields: [ruleVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy       User                   @relation("ProgressionAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, version], map: "tournament_progressions_tournament_version_key")
