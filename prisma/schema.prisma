// Administrator-entered identity candidates. Matching names never grant authority.
// Team staff appointments remain independent of player-profile identity.
model IdentityRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @map("organization_id") @db.Uuid
  kind                String          @db.VarChar(32)
  displayName         String          @map("display_name") @db.VarChar(120)
  teamId              String?         @map("team_id") @db.Uuid
  playerProfileId     String?         @map("player_profile_id") @db.Uuid
  scopeType           String          @map("scope_type") @db.VarChar(32)
  scopeId             String          @map("scope_id") @db.VarChar(64)
  status              String          @default("ACTIVE") @db.VarChar(16)
  linkedUserId        String?         @map("linked_user_id") @db.Uuid
  grantedAssignmentId String?         @map("granted_assignment_id") @db.Uuid
  grantedAssignment   RoleAssignment? @relation(fields: [grantedAssignmentId], references: [id], onDelete: Restrict)
  createdByUserId     String          @map("created_by_user_id") @db.Uuid
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team                Team?           @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  playerProfile       PlayerProfile?  @relation(fields: [playerProfileId, organizationId], references: [id, organizationId], onDelete: Restrict)
  linkedUser          User?           @relation("IdentityRecordUser", fields: [linkedUserId], references: [id], onDelete: Restrict)
  createdBy           User            @relation("IdentityRecordCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, displayName, status], map: "identity_records_org_name_status_idx")
  @@map("identity_records")
}

model IdentityApplication {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  userId              String       @map("user_id") @db.Uuid
  kind                String       @db.VarChar(32)
  teamId              String?      @map("team_id") @db.Uuid
  candidateId         String?      @map("candidate_id") @db.VarChar(64)
  message             String       @db.VarChar(1000)
  status              String       @default("PENDING") @db.VarChar(16)
  version             Int          @default(1)
  resolvedCandidateId String?      @map("resolved_candidate_id") @db.VarChar(64)
  reviewedByUserId    String?      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  decisionNote        String?      @map("decision_note") @db.VarChar(1000)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team                Team?        @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user                User         @relation("IdentityApplicant", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy          User?        @relation("IdentityReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, status], map: "identity_applications_org_user_status_idx")
  @@map("identity_applications")
}

// Polymorphic target IDs deliberately survive match-event correction/replacement.
model AiModerationSetting {
  organizationId String @id @map("organization_id") @db.Uuid
  enabled Boolean @default(false)
  baseUrl String @default("") @map("base_url") @db.VarChar(512)
  model String @default("") @db.VarChar(120)
  protocol String @default("CHAT_COMPLETIONS") @db.VarChar(32)
  encryptedKey String? @map("encrypted_key") @db.Text
  activeProfileId String? @map("active_profile_id") @db.Uuid
  activeProfile AiModerationProvider? @relation(fields:[activeProfileId,organizationId], references:[id,organizationId], onDelete:Restrict, map:"ai_moderation_settings_profile_fkey")
  policies Json @default("{}") @db.JsonB
  version Int @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id],onDelete:Restrict,map:"ai_moderation_settings_org_fkey")
  @@map("ai_moderation_settings")
}

model AiModerationProvider {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(80)
  provider String @db.VarChar(32)
  baseUrl String @map("base_url") @db.VarChar(512)
  model String @db.VarChar(120)
  protocol String @default("CHAT_COMPLETIONS") @db.VarChar(32)
  encryptedKey String? @map("encrypted_key") @db.Text
  version Int @default(1)
  lastTestedAt DateTime? @map("last_tested_at") @db.Timestamptz(3)
  testSuccessful Boolean? @map("test_successful")
  testLatencyMs Int? @map("test_latency_ms")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict, map:"ai_moderation_providers_org_fkey")
  selectedBy AiModerationSetting[]
  @@unique([organizationId,name],map:"ai_moderation_providers_name_key")
  @@unique([id,organizationId],map:"ai_moderation_providers_id_org_key")
  @@map("ai_moderation_providers")
}

model AiModerationReview {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  resourceType String @map("resource_type") @db.VarChar(32)
  targetId String @map("target_id") @db.Uuid
  purpose String @db.VarChar(40)
  contentVersion String @map("content_version") @db.VarChar(120)
  contentHash String @map("content_hash") @db.Char(64)
  source Json @db.JsonB
  status String @default("QUEUED") @db.VarChar(16)
  decision String? @db.VarChar(16)
  summary String? @db.VarChar(1000)
  needsHumanReview Boolean @default(false) @map("needs_human_review")
  attempts Int @default(0)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id],onDelete:Restrict,map:"ai_moderation_reviews_org_fkey")
  @@unique([organizationId,resourceType,targetId,contentHash],map:"ai_moderation_reviews_content_key")
  @@index([status,leaseUntil,createdAt],map:"ai_moderation_reviews_queue_idx")
  @@index([organizationId,needsHumanReview,reviewedAt],map:"ai_moderation_reviews_human_idx")
  @@map("ai_moderation_reviews")
}

model ManagedMediaAsset {
  id                        String       @id @default(uuid()) @db.Uuid
  organizationId            String       @map("organization_id") @db.Uuid
  uploaderUserId            String       @map("uploader_user_id") @db.Uuid
  clientSubmissionId        String       @map("client_submission_id") @db.VarChar(120)
  purpose                   String       @db.VarChar(32)
  targetId                  String       @map("target_id") @db.Uuid
  targetLabel               String       @map("target_label") @db.VarChar(320)
  matchId                   String?      @map("match_id") @db.Uuid
  eventSignature            String?      @map("event_signature") @db.Char(64)
  checksum                  String       @db.Char(64)
  mimeType                  String       @map("mime_type") @db.VarChar(32)
  bytes                     Int
  width                     Int
  height                    Int
  frames                    Int
  durationMs                Int          @map("duration_ms")
  status                    String       @db.VarChar(16)
  visibility                String       @default("ACTIVE") @db.VarChar(16)
  reviewReason              String?      @map("review_reason") @db.VarChar(1000)
  reviewedByUserId          String?      @map("reviewed_by_user_id") @db.Uuid
  reviewedAt                DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  visibilityChangedByUserId String?      @map("visibility_changed_by_user_id") @db.Uuid
  version                   Int          @default(0)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "managed_media_assets_org_fkey")
  uploader                  User         @relation("ManagedMediaUploader", fields: [uploaderUserId], references: [id], onDelete: Restrict, map: "managed_media_assets_uploader_fkey")
  reviewer                  User?        @relation("ManagedMediaReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict, map: "managed_media_assets_reviewer_fkey")
  visibilityActor           User?        @relation("ManagedMediaVisibilityActor", fields: [visibilityChangedByUserId], references: [id], onDelete: Restrict, map: "managed_media_assets_visibility_actor_fkey")

  @@unique([organizationId, uploaderUserId, clientSubmissionId], map: "managed_media_assets_submission_key")
  @@index([organizationId, purpose, targetId, status, visibility, createdAt(sort: Desc)], map: "managed_media_assets_target_idx")
  @@index([organizationId, status, createdAt(sort: Desc)], map: "managed_media_assets_queue_idx")
  @@index([organizationId, uploaderUserId, createdAt(sort: Desc)], map: "managed_media_assets_uploader_idx")
  @@index([organizationId, matchId, targetId, createdAt(sort: Desc)], map: "managed_media_assets_match_idx")
  @@map("managed_media_assets")
}

model MatchTechnicalLog {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  matchId String @map("match_id") @db.Uuid
  recorderUserId String @map("recorder_user_id") @db.Uuid
