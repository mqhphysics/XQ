  payload             Json                @db.JsonB
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  match               Match               @relation(fields: [matchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reportRevision      MatchReportRevision @relation(fields: [reportRevisionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, matchId], map: "match_result_projections_org_match_key")
  @@index([organizationId, sourceReportVersion], map: "match_result_projections_org_version_idx")
  @@map("match_result_projections")
}

model TournamentProgression {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  tournamentId    String                 @map("tournament_id") @db.Uuid
  version         Int
  sourceHash      String                 @map("source_hash") @db.Char(64)
  sourceVersions  Json                   @map("source_versions") @db.JsonB
  slots           Json                   @db.JsonB
  ruleVersionId   String                 @map("rule_version_id") @db.Uuid
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  reason          String                 @db.VarChar(1000)
